{
  "name": "print-js",
  "homepage": "http://printjs.crabbly.com",
  "description": "A tiny javascript library to help printing from the web.",
  "version": "1.6.0",
  "type": "module",
  "main": "dist/print.cjs",
  "module": "dist/print.mjs",
  "browser": "dist/print.js",
  "unpkg": "dist/print.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/print.mjs",
      "require": "./dist/print.cjs",
      "default": "./dist/print.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./dist/print.css": "./dist/print.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": "https://github.com/crabbly/Print.js",
  "license": "MIT",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:dev": "bun run scripts/build.ts --no-minify",
    "watch": "bun --watch run scripts/build.ts --no-minify",
    "serve": "bun run scripts/serve.ts",
    "start": "bun run build:dev && bun run serve",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test test/unit",
    "test:browsers": "bun run test/browser/run.ts",
    "test:all": "bun run typecheck && bun run test && bun run build && bun run test:browsers"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@types/bun": "^1.1.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "18.3.1",
    "playwright": "1.49.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.80.6",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "author": "Rodrigo Vieira <rodrigo@crabbly.com>",
  "keywords": [
    "printjs",
    "print.js",
    "print-js",
    "print",
    "typescript",
    "react"
  ]
}
